#!/usr/bin/env bash
#
# dev-up: starts the shared session stack for this workbench and waits until
# every container in it is healthy. PROFILE adds an opt-in profile's
# fragments (objekt, maskin) to the default ones.
#

source "${0%/*}/functions.sh" || exit $?

profiles=(default)
[[ -n "$PROFILE" && "$PROFILE" != "default" ]] && profiles+=("$PROFILE")

#
# Plays the default fragments and the chosen profile's into the stack.
#
function play_fragments()
{
	local dir

	for dir in $(fragments "${profiles[@]}"); do
		log "playing $dir ..."
		play_fragment "$dev_stack" "$root/$dir" fixed || return $?
	done
}

init        || exit $?
need_stack  || exit $?
need_podman || exit $?
need_tools  || exit $?

stack_prepare "$dev_stack" || fail "Could not prepare the session stack!"
trap 'rm -rf "$stack_work"' EXIT

play_fragments           || fail "A fragment did not start!"
wait_healthy "$dev_stack" || fail "The session stack did not become healthy!"

log "The session stack is up"
