#!/usr/bin/env bash
#
# tools: installs every binary the repository runs into _bin (gitignored,
# skipped by go ./...), each pinned by version. They are never built from
# this repository. Run directly on a fresh machine: it installs task itself.
#
# Renovate moves the pins (renovate.json). It reads the comment above each
# version, so keep comment and variable on adjacent lines. A major version of
# a go-installed tool changes its module path below and is a change by hand.
#

source "${0%/*}/functions.sh" || exit $?

# renovate: datasource=go depName=github.com/go-task/task/v3
task_version="v3.54.0"
# renovate: datasource=go depName=github.com/google/ko
ko_version="v0.19.1"
# renovate: datasource=go depName=github.com/sigstore/cosign/v3
cosign_version="v3.1.3"
# renovate: datasource=go depName=sigs.k8s.io/kustomize/kustomize/v5
kustomize_version="v5.8.1"
# renovate: datasource=go depName=github.com/google/go-containerregistry
crane_version="v0.22.1"
# renovate: datasource=go depName=github.com/golangci/golangci-lint/v2
golangci_lint_version="v2.15.0"

# flux cannot be go-installed (its go.mod has replace directives), so it is
# taken from its image, pinned by tag and digest. One digest covers every
# platform the image is built for. Renovate moves tag and digest together.
flux_image="ghcr.io/fluxcd/flux-cli:v2.9.5@sha256:704d5529535570a495249b643159c93a9aa88ffca07813c974a54b7ba6edbd86"

#
# Installs one Go command at its pinned version into _bin.
#
function go_install()
{
	local package="$1"

	GOBIN="$bin" go install "$package" || return $?
}

#
# Installs flux from its pinned image with crane, unless that version is
# already there. crane is installed before this runs.
#
function install_flux()
{
	local version platform

	version="${flux_image#*:}"
	version="${version%%@*}"

	if [[ "$("$bin/flux" version --client 2>/dev/null)" == "flux: $version" ]]; then
		return
	fi

	platform="$(go env GOOS)/$(go env GOARCH)" || return $?

	"$bin/crane" export --platform "$platform" "$flux_image" - |
		tar -xf - -C "$bin" --strip-components=3 usr/local/bin/flux ||
		return $?
}

init || exit $?

mkdir -p "$bin" || fail "Could not create $bin!"

# The stamp says which pins _bin was installed from (need_tools). It is
# emptied first, so a run that fails half way leaves no claim behind.
: > "$bin/.pins" || fail "Could not write $bin/.pins!"

log "Installing pinned tools into $bin ..."

go_install "github.com/go-task/task/v3/cmd/task@$task_version"              || fail "Installing task failed!"
go_install "github.com/google/ko@$ko_version"                               || fail "Installing ko failed!"
go_install "github.com/sigstore/cosign/v3/cmd/cosign@$cosign_version"       || fail "Installing cosign failed!"
go_install "sigs.k8s.io/kustomize/kustomize/v5@$kustomize_version"          || fail "Installing kustomize failed!"
go_install "github.com/google/go-containerregistry/cmd/crane@$crane_version" || fail "Installing crane failed!"
go_install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$golangci_lint_version" ||
	fail "Installing golangci-lint failed!"
install_flux                                                                || fail "Installing flux failed!"

tool_pins > "$bin/.pins" || fail "Could not write $bin/.pins!"

log "Tools are installed"
