#!/usr/bin/env bash
#
# verify: tier 2. Plays the default and verify fragments and every product's
# own manifests, with images ko builds from this commit, into a stack private
# to the commit; runs the contract and black-box suites from outside; and
# tears the stack down. The result is pinned to the commit, so the tree must
# be clean.
#

source "${0%/*}/functions.sh" || exit $?

verify_suite="${VERIFY_SUITE:-}"

#
# Exports where a suite reaches what was just played: one variable per
# published port, STACK_<NAME>_<CONTAINER PORT>=127.0.0.1:<host port>.
#
function export_ports()
{
	local name="$1"
	local pod id line port

	name="$(printf '%s' "$name" | tr '[:lower:]-' '[:upper:]_')"

	for pod in "${played_pods[@]}"; do
		for id in $(podman ps -q --filter "pod=$pod"); do
			while IFS= read -r line; do
				[[ -n "$line" ]] || continue

				port="${line%%/*}"
				export "STACK_${name}_${port}=${line##* }"
			done <<< "$(podman port "$id" 2>/dev/null)"
		done
	done
}

#
# Plays the fragments every verify stack has.
#
function play_fragments()
{
	local dir

	for dir in $(fragments default verify); do
		log "playing $dir ..."
		play_fragment "$stack" "$root/$dir" random || return $?
		export_ports "${dir##*/}"
	done
}

#
# Plays every product that has manifests: its deploy/base, with each ko://
# reference built from this commit and loaded into podman.
#
function play_products()
{
	local module product manifests

	for module in "${modules[@]}"; do
		product="${module##*/}"
		manifests="$stack_work/$product.yaml"
		[[ -d "$module/deploy/base" ]] || continue

		log "building and playing $product ..."
		render "$stack" "$module/deploy/base" > "$manifests.in" || return $?
		(
			cd "$module" &&
			KO_DOCKER_REPO=ko.local ko resolve --local \
				--tags="$commit" -f "$manifests.in"
		) > "$manifests" || return $?

		refuse_host_ports "$manifests"    || return $?
		play "$stack" "$manifests" random || return $?
		export_ports "$product"
	done
}

#
# Runs the contract and black-box suites against the stack: the tests under
# the verify build tag in every module, or VERIFY_SUITE when it is set.
# go.work has no root module, so ./... from the root matches nothing; the
# suite runs in each module instead. STACK names the stack, and the STACK_*
# variables say where each port is.
#
function run_suite()
{
	local module

	export STACK="$stack"

	if [[ -n "$verify_suite" ]]; then
		bash -c "$verify_suite" || return $?
		return
	fi

	for module in "${modules[@]}"; do
		go -C "$module" test -count=1 -tags verify ./... || return $?
	done
}

#
# Prints the end of every container's log when the run failed, then removes
# the stack, the images built for this commit and the work directory.
#
function teardown()
{
	local status=$?
	local id image ref

	if (( status != 0 )); then
		for id in $(stack_containers "$stack"); do
			log "last lines of $(podman inspect --format '{{.Name}}' "$id"):"
			podman logs --tail 40 "$id" 2>&1
		done
	fi

	stack_down "$stack"

	# Never forced: an image another stack still runs stays where it is.
	for image in $(podman images --quiet \
	                   --filter "reference=ko.local/*:$commit" | sort -u); do
		for ref in $(podman image inspect \
		                 --format '{{range .RepoTags}}{{println .}}{{end}}' \
		                 "$image"); do
			podman rmi "$ref" >/dev/null 2>&1
		done
	done

	rm -rf "$stack_work"
}

init         || exit $?
need_stack   || exit $?
need_podman  || exit $?
need_tools   || exit $?
load_modules || fail "Could not list the modules in go.work!"

commit="$(git rev-parse HEAD)" || fail "Not a git repository!"
stack="verify-$(git rev-parse --short=12 HEAD)"

clean_tree . || fail "verify needs a clean tree: the result is pinned to $commit"

stack_prepare "$stack" || fail "Could not prepare the verify stack!"
trap teardown EXIT

play_fragments        || fail "A fragment did not start!"
play_products         || fail "Building or playing a product failed at $commit!"
wait_healthy "$stack" || fail "The verify stack did not become healthy!"

run_suite || fail "The verify suite failed at $commit!"
