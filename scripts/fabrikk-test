#!/usr/bin/env bash
#
# fabrikk-test: checks fabrikk itself, the factory and not what it builds.
# The extensions' own tests, every factory definition with its saved
# scenarios, and every workflow. A work item's verification does not run
# it, since that loads the extensions from the main checkout
# and not from the work item's worktree. Run it before a change to the
# factory goes into a pull request.
#

source "${0%/*}/functions.sh" || exit $?

# swamp ships the Deno its extensions run on. DENO names another one.
deno="${DENO:-$HOME/.swamp/deno/deno}"

#
# Fails outside the main checkout: swamp's pulled extensions and its data
# are there, and a worktree has neither.
#
function need_main_checkout()
{
	[[ "$(main_checkout)" == "$root" ]] && return

	error "fabrikk.test runs in the main checkout, $(main_checkout): swamp's extensions and data are there"
	return 1
}

#
# Fails unless swamp and its Deno can be run.
#
function need_swamp()
{
	if ! command -v swamp >/dev/null; then
		error "swamp is not on PATH"
		return 1
	fi

	if [[ ! -x "$deno" ]]; then
		error "no Deno at $deno: swamp installs its own; DENO names another"
		return 1
	fi
}

#
# Runs a command and keeps its output to itself unless the command fails.
#
function quietly()
{
	local output

	output="$("$@" 2>&1)" && return

	echo "$output"
	return 1
}

#
# Runs the tests next to the extensions' model types.
#
function test_extensions()
{
	log "testing the extensions ..."
	quietly "$deno" test -A extensions/models/ || return $?
}

#
# Validates every factory definition and plays its saved scenarios.
#
function validate_factories()
{
	local file factory

	for file in models/@swamp/stagecraft/factory/*.yaml; do
		[[ -f "$file" ]] || continue

		factory="${file##*/}"
		factory="${factory%.yaml}"
		log "validating the factory $factory and its scenarios ..."
		quietly swamp behavior run "$factory" validate || return $?
	done
}

#
# Validates every workflow against its schema.
#
function validate_workflows()
{
	local file name

	for file in workflows/workflow-*.yaml; do
		[[ -f "$file" ]] || continue

		name="$(grep -m1 '^name:' "$file")" || return $?
		name="${name#name: }"
		log "validating the workflow $name ..."
		quietly swamp workflow validate "$name" || return $?
	done
}

init               || exit $?
need_main_checkout || exit $?
need_swamp         || exit $?

test_extensions    || fail "An extension's tests failed!"
validate_factories || fail "A factory definition is not valid!"
validate_workflows || fail "A workflow is not valid!"

log "fabrikk is sound"
