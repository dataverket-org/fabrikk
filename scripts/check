#!/usr/bin/env bash
#
# check: tier 0. SPDX headers, gofmt, go vet, golangci-lint and go test over
# every module in go.work. Rules a check can decide are decided here, not by
# a reviewer (agent-constraints/implementation-conventions.md, "Source
# standards").
#

source "${0%/*}/functions.sh" || exit $?

spdx_header="SPDX-License-Identifier: AGPL-3.0-or-later"

#
# Fails when a tracked Go file does not carry the SPDX header, naming each.
#
function check_spdx()
{
	local files file
	local missing=0

	files="$(git ls-files -- '*.go')" || return $?
	[[ -z "$files" ]] && return

	while IFS= read -r file; do
		if ! grep -q -F "$spdx_header" "$file"; then
			error "missing '$spdx_header': $file"
			missing=1
		fi
	done <<< "$files"

	return $missing
}

#
# Fails when gofmt would change a file in any module, naming each.
#
function check_gofmt()
{
	local unformatted

	unformatted="$(gofmt -l "${modules[@]}" </dev/null)" || return $?
	[[ -z "$unformatted" ]] && return

	error "gofmt:"
	echo "$unformatted" >&2
	return 1
}

#
# Runs go vet in every module.
#
function check_vet()
{
	local module

	for module in "${modules[@]}"; do
		go -C "$module" vet ./... || return $?
	done
}

#
# Runs golangci-lint once from the repository root over every module, which
# go.work makes one workspace. It reads .golangci.yml at the root. With no
# module there is nothing to name, and ./... matches nothing from the root.
#
function check_lint()
{
	[[ ${#modules[@]} -eq 0 ]] && return

	golangci-lint run "${modules[@]/%//...}" || return $?
}

#
# Runs go test in every module.
#
function check_test()
{
	local module

	for module in "${modules[@]}"; do
		go -C "$module" test ./... || return $?
	done
}

init         || exit $?
load_modules || fail "Could not list the modules in go.work!"

# With no module there is nothing a tool is needed for.
[[ ${#modules[@]} -eq 0 ]] || need_tools || exit $?

check_spdx  || fail "Go files are missing the SPDX header!"
check_gofmt || fail "Go files are not formatted!"
check_vet   || fail "go vet failed!"
check_lint  || fail "golangci-lint found problems!"
check_test  || fail "go test failed!"
