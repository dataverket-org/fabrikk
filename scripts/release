#!/usr/bin/env bash
#
# release: builds a product's images, joins them with every miljo overlay
# for it, and pushes, signs and tags one config artifact per environment as
# :candidate. Run by CI on shared infrastructure after merge, never on a
# workbench (delivery skill).
#

source "${0%/*}/functions.sh" || exit $?

product="${PRODUCT:-}"
miljo="${MILJO:-../miljo}"
registry="${REGISTRY:-registry.dataverket.org}"
cosign_key="${COSIGN_KEY:-}"
source_url="${SOURCE_URL:-}"

#
# Prints every environment that has an overlay for the product in miljo.
#
function environments()
{
	local overlay env

	for overlay in "$miljo/environments"/*/"$product"; do
		[[ -d "$overlay" ]] || continue

		env="${overlay%/*}"
		echo "${env##*/}"
	done
}

#
# L1: renders the product's manifests with images built once by ko and
# pinned by digest. Every environment shares the result.
#
function build_base()
{
	mkdir -p "$work/base" || return $?
	kustomize build "$product/deploy/base" > "$work/base.yaml" || return $?

	(
		cd "$product" &&
		KO_DOCKER_REPO="$registry/$product" ko resolve \
			--base-import-paths --sbom=none --tags="$commit" \
			-f "$work/base.yaml"
	) > "$work/base/resources.yaml" || return $?

	printf 'resources:\n- resources.yaml\n' \
		> "$work/base/kustomization.yaml" || return $?
}

#
# The join: renders one environment's overlay, whose kustomization lists
# ../base, into its manifests.
#
function render()
{
	local env="$1"
	local dir="$work/$env"

	mkdir -p "$dir/rendered"                            || return $?
	cp -R "$work/base" "$dir/base"                      || return $?
	cp -R "$miljo/environments/$env/$product" "$dir/overlay" || return $?
	kustomize build "$dir/overlay" > "$dir/rendered/manifests.yaml" ||
		return $?
}

#
# Fails when a rendered manifest references an image by anything but a
# digest, printing the offending lines.
#
function pinned_by_digest()
{
	local manifests="$1"

	if grep -E '^\s*-?\s*image:' "$manifests" |
	   grep -vE '@sha256:[0-9a-f]{64}\s*$'; then
		return 1
	fi
}

#
# Prints the images of a rendered manifest as the lines of a JSON object,
# name to digest.
#
function image_digests()
{
	local manifests="$1"

	grep -oE 'image:\s*\S+@sha256:[0-9a-f]{64}' "$manifests" |
		sed -E 's/image:\s*//' | sort -u |
		sed -E 's#^.*/([^/@:]+)(:[^@]*)?@(sha256:[0-9a-f]{64})$#    "\1": "\3"#' |
		paste -sd, - | sed 's/,/,\n/g'
}

#
# Writes release.json next to an environment's rendered manifests.
#
function write_release_json()
{
	local env="$1"
	local dir="$work/$env/rendered"
	local images

	images="$(image_digests "$dir/manifests.yaml")" || return $?

	printf '{\n  "product": "%s",\n  "environment": "%s",\n  "app_commit": "%s",\n  "env_config_version": "%s",\n  "images": {\n%s\n  }\n}\n' \
		"$product" "$env" "$commit" "$env_config_version" "$images" \
		> "$dir/release.json" || return $?
}

#
# Pushes an environment's rendered config as an OCI artifact, signs its
# digest, and tags it :candidate.
#
function push_and_sign()
{
	local env="$1"
	local dir="$work/$env"
	local ref="$registry/$product/config-$env"
	local digest

	# --reproducible: the same commit and miljo version give the same
	# digest, so a re-run cannot move the release.
	flux push artifact "oci://$ref:$commit" --path="$dir/rendered" \
		--reproducible --source="$source_url" \
		--revision="main@sha1:$commit" --output json \
		> "$dir/push.json" || return $?

	digest="$(grep -oE 'sha256:[0-9a-f]{64}' "$dir/push.json" | head -1)" ||
		return $?

	# Key-based, no public transparency log (sovereign): cosign v3 needs
	# both flags for that.
	cosign sign --yes --use-signing-config=false --tlog-upload=false \
		--key "$cosign_key" "$ref@$digest" || return $?
	flux tag artifact "oci://$ref:$commit" --tag candidate || return $?

	log "released $ref@$digest (app $commit, $miljo $env_config_version)"
}

#
# Renders, checks, pushes and signs one environment.
#
function release_environment()
{
	local env="$1"
	local manifests="$work/$env/rendered/manifests.yaml"

	render "$env" || return $?

	if ! pinned_by_digest "$manifests"; then
		error "$env: image not pinned by digest"
		return 1
	fi

	write_release_json "$env" || return $?
	push_and_sign "$env"      || return $?
}

init || exit $?

[[ -n "$product" ]]    || fail "PRODUCT is required"
[[ -n "$cosign_key" ]] || fail "COSIGN_KEY is required"

need_tools || exit $?

clean_tree .        || fail "release needs a clean tree"
clean_tree "$miljo" || fail "release needs a clean $miljo"

[[ -n "$source_url" ]] || source_url="$(git remote get-url origin 2>/dev/null)"

commit="$(git rev-parse HEAD)"                       || fail "Not a git repository!"
env_config_version="$(git -C "$miljo" rev-parse HEAD)" || fail "$miljo is not a git repository!"

envs="$(environments)"
[[ -n "$envs" ]] ||
	fail "no overlay for $product in $miljo/environments/*/$product"

work="$(mktemp -d)" || fail "Could not create a work directory!"
trap 'rm -rf "$work"' EXIT

build_base || fail "Building the base for $product failed!"

for env in $envs; do
	release_environment "$env" || fail "Releasing $product to $env failed!"
done
