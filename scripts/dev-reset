#!/usr/bin/env bash
#
# dev-reset: runs every fragment's reset script, returning each service to
# its seeded state. WIPE=1 stops the session stack and removes its volumes
# too.
#

source "${0%/*}/functions.sh" || exit $?

wipe="${WIPE:-}"

#
# Runs the reset script of every fragment that has one.
#
function reset_fragments()
{
	local script

	for script in "$fragments_dir"/*/*/reset.sh; do
		[[ -x "$script" ]] || continue

		log "reset: $script"
		"$script" || return $?
	done
}

#
# Takes down every fragment of the session stack with the volumes its
# manifests declare. The verify profile is not part of the session stack.
#
function wipe_fragments()
{
	local profile dir

	for profile in "$fragments_dir"/*/; do
		profile="${profile%/}"
		profile="${profile##*/}"
		[[ "$profile" == "verify" ]] && continue

		for dir in $(fragments "$profile"); do
			render "$dev_stack" "$root/$dir" |
				podman kube down --force - >/dev/null || return $?
		done
	done
}

init        || exit $?
need_stack  || exit $?
need_podman || exit $?
need_tools  || exit $?

reset_fragments || fail "A fragment's reset script failed!"

if [[ -n "$wipe" ]]; then
	stack_work="$(mktemp -d)" || fail "Could not create a work directory!"
	trap 'rm -rf "$stack_work"' EXIT

	wipe_fragments          || fail "Removing the session stack's volumes failed!"
	stack_down "$dev_stack" || fail "Stopping the session stack failed!"
fi
